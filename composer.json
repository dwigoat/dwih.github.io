{
    "name": "cahyo/portfolio",
    "type": "project",
    "description": "Personal portfolio website built with Laravel and Blade",
    "keywords": ["laravel", "portfolio"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
